---
import { links } from "../config";
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "See what vWorkspace can do with your real workflows",
  text = "Pick one real workflow and test it in a dedicated cloud or on-prem pilot. No hardware is required for a cloud pilot.",
  primaryLabel = "Start a pilot",
  primaryHref = links.pilot,
  secondaryLabel = "Explore the product",
  secondaryHref = "/product/",
} = Astro.props;
const secondaryExternal = secondaryHref.startsWith("http");
---

<section class="cta">
  <div class="container cta__inner">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="btn-row cta__row">
      <a class="btn btn--on-dark" href={primaryHref}>{primaryLabel}</a>
      <a
        class="btn btn--ghost-on-dark"
        href={secondaryHref}
        {...(secondaryExternal ? { target: "_blank", rel: "noopener" } : {})}
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(900px 400px at 80% -20%, rgba(0, 105, 255, 0.35), transparent 60%),
      radial-gradient(700px 360px at 0% 120%, rgba(0, 194, 255, 0.18), transparent 60%),
      var(--dark-bg);
    color: var(--dark-text);
  }
  .cta__inner {
    text-align: center;
    padding-block: clamp(48px, calc(4vw + 22px), 80px);
  }
  .cta h2 {
    color: #fff;
    font-size: clamp(24px, calc(2vw + 14px), 34px);
    max-width: 26ch;
    margin-inline: auto;
  }
  .cta p {
    color: var(--dark-muted);
    font-size: var(--text-lg);
    margin: 14px auto 24px;
    max-width: 58ch;
  }
  .cta__row {
    justify-content: center;
  }
</style>
