---
import { links } from "../config";
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "Own your workspace",
  text = "Join the pilot program and get vWorkspace preinstalled and supported on hardware at your site — or deploy the platform on your own cluster.",
  primaryLabel = "Request a pilot",
  primaryHref = links.contact,
  secondaryLabel = "Get started",
  secondaryHref = links.quickstart,
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="btn-row cta__row">
      <a class="btn btn--on-dark" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--ghost-on-dark" href={secondaryHref} target="_blank" rel="noopener">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(900px 400px at 80% -20%, rgba(0, 105, 255, 0.35), transparent 60%),
      radial-gradient(700px 360px at 0% 120%, rgba(0, 194, 255, 0.18), transparent 60%),
      var(--dark-bg);
    color: var(--dark-text);
  }
  .cta__inner {
    text-align: center;
    padding-block: clamp(64px, 9vw, 104px);
  }
  .cta h2 {
    color: #fff;
    font-size: clamp(28px, 4vw, 40px);
    max-width: 22ch;
    margin-inline: auto;
  }
  .cta p {
    color: var(--dark-muted);
    font-size: 19px;
    margin: 18px auto 30px;
    max-width: 58ch;
  }
  .cta__row {
    justify-content: center;
  }
</style>
