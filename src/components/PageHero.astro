---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}
const { eyebrow, title, text } = Astro.props;
---

<section class="pagehero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {text && <p class="lead measure">{text}</p>}
  </div>
</section>

<style>
  .pagehero {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(28px, 4vw, 48px);
    background:
      radial-gradient(760px 340px at 84% -20%, rgba(0, 105, 255, 0.08), transparent 64%);
  }
  .pagehero h1 {
    font-size: clamp(34px, 5vw, 52px);
    max-width: 18ch;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehero .lead {
    margin-top: 20px;
  }
</style>
