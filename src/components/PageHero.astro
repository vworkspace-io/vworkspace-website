---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}
const { eyebrow, title, text } = Astro.props;
---

<section class="pagehero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {text && <p class="lead measure">{text}</p>}
  </div>
</section>

<style>
  .pagehero {
    padding-top: clamp(44px, calc(4vw + 18px), 72px);
    padding-bottom: clamp(24px, calc(2vw + 12px), 40px);
    background:
      radial-gradient(760px 340px at 84% -20%, rgba(0, 105, 255, 0.08), transparent 64%);
  }
  .pagehero h1 {
    font-size: var(--heading-page);
    max-width: 20ch;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehero .lead {
    margin-top: 16px;
  }
</style>
