---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const capabilities = [
  {
    id: "knowledge",
    label: "Knowledge",
    title: "Private company search",
    body: "Search approved PDFs and Nextcloud folders, ask questions in natural language, summarize content, and inspect source references.",
    href: "/knowledge/",
    link: "Explore knowledge search",
  },
  {
    id: "nextcloud",
    label: "Files",
    title: "Nextcloud operations",
    body: "Review service health, users, shares, folders, and storage. Find and summarize content without leaving the workspace.",
    href: "/ai-experts/#nextcloud",
    link: "Meet the Nextcloud Expert",
  },
  {
    id: "netbird",
    label: "Private access",
    title: "NetBird management",
    body: "Inspect peers, groups, policies, routes, DNS, and connectivity. Prepare setup keys and access changes for approval.",
    href: "/netbird-ai/",
    link: "Explore NetBird operations",
  },
  {
    id: "identity",
    label: "Identity",
    title: "vWorkspace SSO",
    body: "Review users, groups, access, and provisioning. Coordinate onboarding and offboarding across Nextcloud and NetBird.",
    href: "/ai-experts/#users",
    link: "Meet the Users Expert",
  },
  {
    id: "projects",
    label: "Work",
    title: "Projects and tasks",
    body: "See overdue work, workload, milestones, timesheets, and deadline risk. Prepare assignments and task updates for approval.",
    href: "/ai-experts/#projects",
    link: "Meet the Projects Expert",
  },
  {
    id: "storage",
    label: "Data",
    title: "Storage and backup",
    body: "Browse S3-compatible storage, move objects, review backup health and restore points, and approve an immediate backup.",
    href: "/ai-experts/#storage",
    link: "Meet the Storage Expert",
  },
];

const stack = [
  ["Control plane", "Workspace UI, knowledge, catalog, identity, projects, operations, storage, audit, and AI coordination."],
  ["Cluster operator", "Applies declared work locally and reports status through the pull-mode agent."],
  ["Open controllers", "Flux and Helm reconcile applications. Velero handles supported backup operations."],
  ["AI runtime", "Use local models on a suitable GPU or connect a configured OpenAI-compatible API. A local GPU is optional."],
];
---

<BaseLayout
  title="Private AI Workspace Product and Features"
  description="Explore vWorkspace features for private knowledge search, Nextcloud, NetBird, identity, projects, S3 storage, backups, and human-approved AI operations."
>
  <PageHero
    eyebrow="Product"
    title="Connect the information your team needs with the systems that run it"
    text="Search company knowledge, work with Nextcloud, manage NetBird access, coordinate users and projects, and keep storage and backups visible from one workspace."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">What it does</span>
      <h2 class="section-title">Built around work people already need to do</h2>
      <p class="lead section-intro">
        vWorkspace gives people a direct way to find information and gives
        administrators a controlled way to investigate and change the
        environment behind it.
      </p>
      <div class="content-grid content-grid--3">
        {capabilities.map((item) => (
          <article class="content-card" id={item.id}>
            <span class="content-card__label">{item.label}</span>
            <h3>{item.title}</h3>
            <p class="muted">{item.body}</p>
            <a class="text-link" href={item.href}>{item.link}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container content-split">
      <div>
        <span class="eyebrow">AI Experts</span>
        <h2 class="section-title">Ask the workspace instead of checking every system yourself</h2>
        <p class="muted">
          Mention <code>@AI</code> in Discuss. vWorkspace sends the request to
          the expert for knowledge, projects, Nextcloud, infrastructure, users,
          NetBird, or storage and brings the result back to one conversation.
        </p>
        <a class="text-link" href="/ai-experts/">Meet the AI experts</a>
      </div>
      <div class="callout">
        <strong>Read first, approve changes</strong>
        <p class="muted">
          Experts can inspect approved data and tools directly. Changes to
          users, projects, Nextcloud, NetBird, or backups wait for an authorized
          person to approve or reject the plan.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">How it runs</span>
      <h2 class="section-title">A guided product on an open foundation</h2>
      <p class="lead section-intro">
        The technical layers remain visible and operable. Teams that want a
        managed pilot do not need to assemble them before evaluating the
        product.
      </p>
      <div class="stack">
        {stack.map(([name, detail]) => (
          <div class="stack__row">
            <strong>{name}</strong>
            <p class="muted">{detail}</p>
          </div>
        ))}
      </div>
      <div class="btn-row docs-row">
        <a class="btn btn--secondary" href={links.operatorDocs} target="_blank" rel="noopener">Read operator docs</a>
        <a class="btn btn--secondary" href={links.serverDocs} target="_blank" rel="noopener">Read server docs</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Deployment options</span>
        <h2 class="section-title">Start without hardware or run it where you need it</h2>
      </div>
      <div class="deployment">
        <article>
          <h3>Dedicated cloud pilot</h3>
          <p class="muted">Evaluate knowledge search, AI experts, and workspace workflows in a dedicated environment without buying hardware first.</p>
          <a class="text-link" href="/cloud-pilot/">Explore the cloud pilot</a>
        </article>
        <article>
          <h3>Ready-to-run appliance</h3>
          <p class="muted">Use supported hardware at your site with local infrastructure and optional local AI.</p>
          <a class="text-link" href="/appliance/">Explore the appliance</a>
        </article>
        <article>
          <h3>Your own infrastructure</h3>
          <p class="muted">Deploy the open core on a conformant Kubernetes cluster and connect your storage and preferred AI runtime.</p>
          <a class="text-link" href={links.quickstart} target="_blank" rel="noopener">Open the quickstart</a>
        </article>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .content-card .text-link {
    margin-top: 14px;
  }
  .stack {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .stack__row {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .stack__row strong {
    color: var(--ink-900);
    font-size: 15px;
  }
  .stack__row p {
    font-size: 15px;
  }
  .docs-row {
    margin-top: 28px;
  }
  .deployment {
    display: grid;
    gap: 32px;
  }
  .deployment article + article {
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .deployment h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }
  @media (max-width: 720px) {
    .stack__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
