---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const capabilities = [
  ["Health and connectivity", "Check whether NetBird is healthy for the workspace and investigate why a peer cannot reach a service."],
  ["Peers and groups", "List connected devices, review group membership, and understand how access is organized."],
  ["Policies and routes", "Inspect access policies, network routes, and the context that determines whether traffic is allowed."],
  ["Setup keys", "Review setup-key metadata and prepare a one-time key through an approved administrator workflow."],
  ["DNS configuration", "Inspect the DNS configuration used by the private network when investigating name-resolution problems."],
  ["Approved changes", "Prepare group and policy changes, show the plan, and wait for an authorized person before applying them."],
];

const scenarios = [
  {
    question: "Why can this laptop not reach Nextcloud?",
    answer: "Review peer status, group membership, relevant policies, routes, and DNS before suggesting the next check.",
  },
  {
    question: "Who can reach the finance application?",
    answer: "Inspect the groups and policies that grant access, then return a readable access summary.",
  },
  {
    question: "Add this employee to the remote access group.",
    answer: "Prepare the group change and pause for an authorized administrator to approve or reject it.",
  },
];

const faq = [
  {
    question: "Does the NetBird AI Expert make network changes automatically?",
    answer: "No. Read and troubleshooting requests can run directly. Setup-key, group, and policy changes require approval from an authorized administrator.",
  },
  {
    question: "Will credentials appear in the AI conversation?",
    answer: "Credentials and one-time secrets should not appear in chat answers or tool results. Secret handling remains part of the controlled product workflow.",
  },
  {
    question: "Can NetBird work with Nextcloud in the same workspace?",
    answer: "Yes. vWorkspace can use NetBird as the private-access layer around services such as Nextcloud while keeping identity and operational context in the workspace.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="NetBird AI Management and Connectivity Troubleshooting"
  description="Review NetBird peers, groups, policies, routes, DNS, setup keys, and connectivity with a private AI expert and human-approved network changes."
  schema={faqSchema}
>
  <PageHero
    eyebrow="NetBird and private access"
    title="Understand who can connect and why access fails"
    text="The vWorkspace NetBird AI Expert reviews private-network health, peers, groups, policies, routes, DNS, and connectivity. Sensitive changes stay behind administrator approval."
  />

  <section class="section section--tight">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Private access in context</span>
        <h2 class="section-title">Troubleshoot the path, not only the device</h2>
        <p class="muted">
          A failed connection can involve peer state, group membership,
          policies, routes, or DNS. vWorkspace brings those signals together
          with the user and application context behind the request.
        </p>
      </div>
      <div class="network-path" aria-label="Private access path">
        <span>Employee device</span>
        <small>through a NetBird peer</small>
        <span>Access group and policy</span>
        <small>over a private route</small>
        <span>Nextcloud or internal service</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">NetBird features</span>
      <h2 class="section-title">The information an administrator needs for the next decision</h2>
      <div class="capabilities">
        {capabilities.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Example requests</span>
      <h2 class="section-title">Ask a direct network question</h2>
      <div class="scenarios">
        {scenarios.map((scenario) => (
          <article>
            <p class="scenario-question">{scenario.question}</p>
            <p class="muted">{scenario.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Identity and access</span>
        <h2 class="section-title">Connect network access to the employee lifecycle</h2>
        <p class="muted">
          vWorkspace SSO is the source of truth for workspace users. NetBird and
          Nextcloud are downstream surfaces that can be reviewed during
          onboarding, access checks, and offboarding.
        </p>
        <a class="text-link" href="/product/#identity">Explore identity features</a>
      </div>
      <div class="approval">
        <strong>Read directly</strong>
        <p>Health, peers, groups, policies, routes, DNS, and connectivity context.</p>
        <strong>Approve before change</strong>
        <p>Setup keys, group membership, and policy adjustments.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Questions</span>
      <h2 class="section-title">Using NetBird with vWorkspace</h2>
      <div class="faq">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Test a real private-access workflow"
    text="Bring a representative NetBird connectivity or access-review case to a focused pilot."
    secondaryLabel="Meet the NetBird Expert"
    secondaryHref="/ai-experts/#netbird"
  />
</BaseLayout>

<style>
  .network-path {
    display: grid;
    gap: 8px;
  }
  .network-path span {
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-900);
    font-size: 14px;
    font-weight: 600;
  }
  .network-path small {
    padding-left: 18px;
    color: var(--ink-500);
    font-size: 12px;
  }
  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 36px;
  }
  .capabilities article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .capabilities h3 {
    margin-bottom: 8px;
    font-size: 18px;
  }
  .capabilities p {
    font-size: 14px;
  }
  .scenarios {
    display: grid;
    gap: 0;
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .scenarios article {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 36px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .scenario-question {
    margin: 0;
    color: var(--ink-900);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .scenarios p {
    font-size: 14px;
  }
  .approval {
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .approval strong {
    display: block;
    color: var(--ink-900);
    font-size: 14px;
  }
  .approval p {
    margin: 6px 0 20px;
    color: var(--ink-600);
    font-size: 14px;
  }
  .approval p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 820px) {
    .capabilities,
    .scenarios article {
      grid-template-columns: 1fr;
    }
    .scenarios article {
      gap: 12px;
    }
  }
</style>
