---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const audiences = [
  {
    title: "Self-hosting organizations",
    body: "Teams that want to own their workspace — files, networking, org tools, and AI — on infrastructure they control, instead of renting it from a public cloud.",
  },
  {
    title: "Platform & homelab engineers",
    body: "Self-host the open control plane on k3s, Talos, Harvester, or managed Kubernetes. Pull-mode operator, two CRDs, Helm-first — no kubeconfig on the server.",
  },
  {
    title: "Data-sensitive sectors",
    body: "Clinics, legal firms, finance, manufacturing, and public sector — where data residency and audit matter, and a preinstalled appliance removes the ops burden.",
  },
];

const useCases = [
  {
    title: "Private workspace platform",
    body: "Deploy Nextcloud for files, NetBird for secure remote access, and Odoo-for-Org for contacts and invoicing — from one catalog, with GitOps under the hood.",
  },
  {
    title: "Private IT support AI",
    body: "Upload a Nextcloud debug bundle, get GPU-powered analysis and ranked suggestions on your own hardware. Admin approves every action.",
  },
  {
    title: "Backups & audit",
    body: "Velero-backed backups modeled as Operation resources, with a full audit trail on the control plane — uploads, analysis, and day-2 actions logged.",
  },
  {
    title: "Multi-cluster operations",
    body: "Operate many clusters from one server without exposing the Kubernetes API. Same two CRDs on every cluster, reconciled by Flux and Velero.",
  },
];

---

<BaseLayout
  title="Solutions"
  description="Who vWorkspace is for: self-hosting organizations, platform engineers, and data-sensitive sectors — a private workspace platform with private AI, available self-hosted or as a ready-to-run appliance."
>
  <PageHero
    eyebrow="Solutions"
    title="A private workspace, wherever you run it"
    text="vWorkspace fits teams that want to own their workspace platform — self-hosted on their own clusters, or delivered preinstalled and supported on an appliance at their site."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Who it's for</span>
      <div class="grid">
        {
          audiences.map((a) => (
            <article class="card">
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Use cases</span>
      <h2 class="title">What organizations run on it</h2>
      <div class="grid grid--2">
        {
          useCases.map((u) => (
            <article class="card card--flat">
              <h3>{u.title}</h3>
              <p class="muted">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Find the fit for your organization"
    text="Want it preinstalled and supported on hardware at your site? Request a pilot. Running your own clusters? Start with the quickstart."
  />
</BaseLayout>

<style>
  .grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .grid--2 {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 36px;
  }
  .title {
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 14px 0 0;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .card--flat {
    background: var(--surface);
  }
  .card h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  .card p {
    font-size: 15px;
  }

  @media (max-width: 820px) {
    .grid,
    .grid--2 {
      grid-template-columns: 1fr;
    }
  }
</style>
