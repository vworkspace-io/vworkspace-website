---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const solutions = [
  {
    number: "01",
    title: "Replace scattered self-hosted tools",
    problem: "Files, remote access, identities, and operations often live in separate systems with separate operating models.",
    workflow: "vWorkspace connects a role-aware launchpad, vWorkspace SSO, catalog applications, shared operations, and one AI Team.",
    outcome: "A more coherent workspace for users and a smaller operational surface for administrators.",
    href: "/product/",
  },
  {
    number: "02",
    title: "Keep sensitive work private",
    problem: "Organizations need useful AI and collaboration without making a public cloud the default home for their data.",
    workflow: "Run on infrastructure you control, use local AI by default, choose approved providers deliberately, and gate sensitive actions.",
    outcome: "Clearer control over data location, model choice, credentials, and operational change.",
    href: "/ai-team/",
  },
  {
    number: "03",
    title: "Give small IT teams operational leverage",
    problem: "Routine investigation, user lifecycle work, backup checks, and planning consume scarce technical time.",
    workflow: "Ask @AI to route work to specialists for identity, Nextcloud, networking, storage, DevOps, and planning.",
    outcome: "Faster investigation and preparation without handing unrestricted control to an autonomous agent.",
    href: "/ai-team/",
  },
  {
    number: "04",
    title: "Standardize customer deployments",
    problem: "Every bespoke private-cloud deployment creates a different support and upgrade burden.",
    workflow: "Use the same control plane and pull-mode operator contract across an appliance or supported Kubernetes environment.",
    outcome: "A repeatable installation and operations model for internal teams and delivery partners.",
    href: "/appliance/",
  },
  {
    number: "05",
    title: "Modernize Nextcloud operations",
    problem: "A useful file platform still needs identity, secure access, application health context, and recoverable operations around it.",
    workflow: "Deploy Nextcloud from the catalog, connect vWorkspace SSO and NetBird, use file-aware AI workflows, and configure backup storage.",
    outcome: "Nextcloud becomes part of an operated workspace rather than an isolated application.",
    href: "/product/",
  },
];

const audiences = [
  ["Organizations", "15–500 person teams that need private collaboration and practical AI without assembling a platform team."],
  ["Sensitive sectors", "Clinics, legal firms, manufacturers, professional services, and public-sector teams with data-control requirements."],
  ["IT partners", "Teams that deliver and support repeatable private workspace installations for customers."],
];
---

<BaseLayout
  title="Solutions"
  description="Use vWorkspace to consolidate self-hosted tools, keep sensitive work private, help small IT teams, standardize deployments, and modernize Nextcloud operations."
>
  <PageHero
    eyebrow="Solutions"
    title="Private workspace outcomes without a private cloud team"
    text="vWorkspace helps organizations operate collaboration, secure access, identity, storage, backups, and AI as one product—not a pile of unrelated infrastructure."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Who it serves</span>
      <div class="audiences">
        {audiences.map(([title, body]) => (
          <article>
            <h2>{title}</h2>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What changes</span>
      <h2 class="section-title">Five practical reasons to use vWorkspace</h2>
      <div class="solution-list">
        {solutions.map((item) => (
          <article class="solution">
            <span class="solution__number">{item.number}</span>
            <div class="solution__main">
              <h3>{item.title}</h3>
              <p class="muted">{item.problem}</p>
              <a class="text-link" href={item.href}>Explore this workflow →</a>
            </div>
            <dl>
              <div>
                <dt>vWorkspace workflow</dt>
                <dd>{item.workflow}</dd>
              </div>
              <div>
                <dt>Operational outcome</dt>
                <dd>{item.outcome}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Find the fit for your organization"
    text="Join the pilot for a guided fit assessment covering deployment, data control, applications, AI, and operational ownership."
    secondaryLabel="Explore the appliance"
    secondaryHref="/appliance/"
  />
</BaseLayout>

<style>
  .audiences {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 24px;
  }
  .audiences article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .audiences h2 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  .audiences p {
    font-size: 15px;
  }
  .solution-list {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .solution {
    display: grid;
    grid-template-columns: 56px 0.8fr 1.2fr;
    gap: 28px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .solution__number {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .solution h3 {
    font-size: 21px;
    margin-bottom: 10px;
  }
  .solution__main p {
    font-size: 15px;
  }
  .solution dl {
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .solution dt {
    margin-bottom: 4px;
    color: var(--ink-900);
    font-size: 13px;
    font-weight: 700;
  }
  .solution dd {
    margin: 0;
    color: var(--ink-600);
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .audiences,
    .solution {
      grid-template-columns: 1fr;
    }
    .solution {
      gap: 12px;
    }
    .solution dl {
      margin-top: 16px;
    }
  }
</style>
