---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const solutions = [
  {
    number: "01",
    title: "Make company knowledge easier to use",
    body: "Search approved PDFs and Nextcloud folders in natural language. Summarize content, compare documents, and inspect the sources behind each answer.",
    detail: "Useful for policies, project folders, runbooks, support material, and internal reference documents.",
    href: "/knowledge/",
  },
  {
    number: "02",
    title: "Help small IT teams investigate faster",
    body: "Ask AI experts to inspect users, projects, applications, infrastructure, networking, storage, and backups before an administrator steps in.",
    detail: "Read work can run directly. Sensitive changes wait for approval.",
    href: "/ai-experts/",
  },
  {
    number: "03",
    title: "Run Nextcloud with more context",
    body: "Connect files and collaboration to identity, private access, knowledge search, storage, backup, and operational health.",
    detail: "Review users, shares, quotas, folders, and service state from the same workspace.",
    href: "/product/#nextcloud",
  },
  {
    number: "04",
    title: "Understand private access with NetBird",
    body: "Review peers, groups, policies, routes, DNS, and connectivity with user and application context available.",
    detail: "Prepare setup keys, group membership, and policy changes for administrator approval.",
    href: "/netbird-ai/",
  },
  {
    number: "05",
    title: "Coordinate employee access",
    body: "Use vWorkspace SSO as the workspace identity source and review downstream provisioning for Nextcloud and NetBird.",
    detail: "Onboarding, group changes, access levels, and offboarding remain approval-gated.",
    href: "/product/#identity",
  },
  {
    number: "06",
    title: "Check storage and recovery before they become urgent",
    body: "Browse S3-compatible storage, review backup health, inspect recovery points, and understand backup-location status.",
    detail: "Authorized administrators can approve an immediate backup from the Storage Expert.",
    href: "/product/#storage",
  },
];

const audiences = [
  ["Organizations", "Teams of 15 to 500 people that need private collaboration and practical AI without assembling a platform team."],
  ["Sensitive sectors", "Clinics, legal firms, manufacturers, professional services, and public-sector teams with data-control requirements."],
  ["IT partners", "Teams that deliver and support repeatable private workspace installations for customers."],
];
---

<BaseLayout
  title="Private AI Workspace Use Cases"
  description="Explore vWorkspace use cases for company knowledge search, Nextcloud, NetBird, employee access, projects, S3 storage, backups, and small IT teams."
>
  <PageHero
    eyebrow="Solutions"
    title="Practical help for the work behind your workspace"
    text="Find company knowledge, operate Nextcloud, understand NetBird access, coordinate users, and keep projects, storage, and backups visible."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Who it serves</span>
      <h2 class="section-title">Teams that need useful AI without another platform to assemble</h2>
      <div class="audiences">
        {audiences.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What changes</span>
      <h2 class="section-title">Where teams use vWorkspace today</h2>
      <div class="solution-list">
        {solutions.map((item) => (
          <article class="solution">
            <span class="solution__number">{item.number}</span>
            <div class="solution__main">
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
              <a class="text-link" href={item.href}>Explore this use case</a>
            </div>
            <p class="solution__detail">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Choose one useful workflow for a pilot"
    text="Start with one workflow your team already needs to improve, then measure the result in a focused pilot."
    secondaryLabel="Start without hardware"
    secondaryHref="/cloud-pilot/"
  />
</BaseLayout>

<style>
  .audiences {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 24px;
  }
  .audiences article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .audiences h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  .audiences p {
    font-size: 15px;
  }
  .solution-list {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .solution {
    display: grid;
    grid-template-columns: 56px 1fr 0.8fr;
    gap: 28px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .solution__number {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .solution h3 {
    font-size: var(--heading-card);
    margin-bottom: 10px;
  }
  .solution__main p {
    font-size: 15px;
  }
  .solution__detail {
    color: var(--ink-600);
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .audiences,
    .solution {
      grid-template-columns: 1fr;
    }
    .solution {
      gap: 12px;
    }
    .solution__detail {
      margin-top: 16px;
    }
  }
</style>
