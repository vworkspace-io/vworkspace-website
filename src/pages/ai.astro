---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const useCases = [
  {
    title: "Nextcloud sync triage",
    tag: "First to ship",
    body: "Desktop sync failures eat IT hours. Users upload a debug bundle; the local GPU analyzes it and surfaces plain-language problems and suggested fixes — your admin reviews and acts.",
  },
  {
    title: "Cluster log & health analysis",
    tag: "Coming",
    body: "AI reviews cluster and application logs on the appliance, summarizes anomalies, and flags degrading workloads before they become outages — read-only, on your hardware.",
  },
  {
    title: "AI-assisted administration",
    tag: "Coming",
    body: "Routine tasks in plain language — \"add a new employee to Nextcloud\", \"check last night's backup\". AI prepares the operation; the admin approves with one click.",
  },
];

const principles = [
  {
    title: "Data stays on your hardware",
    body: "Debug bundle contents and inference never leave your infrastructure. No cloud API calls, no surprise egress.",
  },
  {
    title: "AI assists, human approves",
    body: "Analysis and suggestions only. Any destructive operation requires explicit admin confirmation through the operations workflow.",
  },
  {
    title: "Read-only analysis",
    body: "The model inspects uploaded bundles and surfaces ranked problems — it does not modify clusters, apps, or user data.",
  },
  {
    title: "Real GPU workload day one",
    body: "Private inference for IT support triage — not shelf decoration. Ollama on your GPU handles the analysis.",
  },
];

const notInV1 = [
  "Autonomous app deploy from chat",
  "Self-healing infrastructure",
  "Unsupervised fixes to production systems",
  "Sending customer data to public LLM APIs",
];
---

<BaseLayout
  title="Private AI"
  description="vWorkspace private AI: IT support triage, cluster log analysis, and AI-assisted administration — local GPU inference with admin approval. Data never leaves your infrastructure."
>
  <PageHero
    eyebrow="Private AI"
    title="An AI assistant for your IT — on your GPU"
    text="vWorkspace builds private inference into the platform: support triage, log analysis, and assisted administration. AI suggests; your admin approves."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Use cases</span>
      <h2 class="title">What private AI does for your organization</h2>
      <div class="grid grid--3">
        {
          useCases.map((u) => (
            <article class="card">
              <span class="card__tag">{u.tag}</span>
              <h3>{u.title}</h3>
              <p class="muted">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>The first workload, end to end</h2>
        <p class="muted">
          Mid-market organizations running Nextcloud lose hours to desktop client sync
          failures. Today, IT collects a debug bundle from the user's machine and reads
          logs manually — slow, repetitive, and easy to get wrong. vWorkspace turns
          that into a guided flow.
        </p>
      </div>
      <div>
        <h2>The vWorkspace flow</h2>
        <ol class="flow-list">
          <li>User uploads the Nextcloud client debug bundle through vWorkspace</li>
          <li>Local GPU (Ollama) analyzes the bundle — read-only, private</li>
          <li>Plain-language problems and suggested fixes are surfaced</li>
          <li>The responsible admin is notified and reviews before acting</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Safety principles</span>
      <h2 class="title">Designed for regulated environments</h2>
      <div class="grid">
        {
          principles.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Honest scope</span>
      <h2 class="title">What AI is not in v1</h2>
      <p class="lead measure">
        Deploying apps is operator UI and GitOps — clicks, not magic. AI focuses on
        support automation, not autonomous operations.
      </p>
      <ul class="not-list">
        {notInV1.map((item) => <li>{item}</li>)}
      </ul>
      <p class="muted note">
        Full debug-bundle upload, analyze, and notify is rolling out in phases. Pilot
        demos may use recorded analysis until the MVP ships.
      </p>
    </div>
  </section>

  <CTA
    title="Private AI, built into your workspace"
    text="See it running on a pilot appliance at your site — Nextcloud users especially welcome."
    primaryLabel="Request a pilot"
    primaryHref={links.contact}
    secondaryLabel="Read the design doc"
    secondaryHref="https://github.com/vworkspace-io/vworkspace/blob/main/docs/design/nextcloud-debug-bundle-ai.md"
  />
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .split h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }
  .flow-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--ink-500);
    font-size: 15px;
  }
  .flow-list li::marker {
    color: var(--brand-600);
    font-weight: 700;
  }
  .section--alt {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .title {
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 14px 0 8px;
  }
  .grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .card__tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-600);
    margin-bottom: 10px;
  }
  .card h3 {
    font-size: 18px;
    margin-bottom: 10px;
  }
  .card p {
    font-size: 15px;
  }
  .not-list {
    margin: 28px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-500);
    font-size: 15px;
  }
  .not-list li::marker {
    color: var(--ink-400);
  }
  .note {
    margin-top: 24px;
    font-size: 14px;
    max-width: 62ch;
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
    .grid,
    .grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
