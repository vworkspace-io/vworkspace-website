---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const modes = [
  {
    name: "Pull mode",
    tag: "Default · shipped",
    body: "The operator initiates outbound HTTPS to the control plane, fetches jobs, applies them locally, and posts status. Nothing inbound, no API exposed.",
    featured: true,
  },
  {
    name: "GitOps mode",
    tag: "Declarative",
    body: "Intent is committed to Git and reconciled by Flux. Same ApplicationInstance and Operation resources, delivered through your existing GitOps pipeline.",
    featured: false,
  },
  {
    name: "Push mode",
    tag: "Planned",
    body: "The control plane reaches the cluster endpoint directly, for environments where inbound connectivity is acceptable. Same CRD contract — on the roadmap, not shipped yet.",
    featured: false,
    muted: true,
  },
];

const crds = [
  {
    name: "ApplicationInstance",
    body: "Desired state of an application: chart, version, values, and lifecycle. Reconciled into a Flux HelmRelease and tracked through conditions.",
  },
  {
    name: "Operation",
    body: "A day-2 action — backup, restore, upgrade, migration — executed by a pluggable engine (Velero, Argo Workflows, Kubernetes Jobs, Helm hooks).",
  },
];

const engines = [
  "Flux Helm Controller",
  "Velero",
  "Argo Workflows",
  "Kubernetes Jobs",
  "Helm hooks",
  "CSI snapshots / VolSync",
];

const stack = [
  { layer: "Control plane", detail: "vWorkspace Server — branded login, workspace home, clusters, catalog, operations, audit" },
  { layer: "Cluster operator", detail: "Pull-mode agent per cluster — reconciles CRDs, executes via Flux and Velero" },
  { layer: "Apps", detail: "Helm-deployed via catalog — Nextcloud, NetBird, and more" },
  { layer: "Private AI", detail: "Ollama on your GPU for support triage (read-only analysis)" },
];
---

<BaseLayout
  title="Platform"
  description="How vWorkspace works: a control plane, pull-mode cluster operator, two CRDs, and proven Kubernetes controllers — self-hostable anywhere, or preinstalled on an appliance."
>
  <PageHero
    eyebrow="Platform"
    title="A small, legible system for operating your workspace"
    text="vWorkspace deliberately keeps its surface area small: one control plane, one pull-mode operator per cluster, and two custom resources reconciled by controllers you already trust."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">The stack</span>
      <h2 class="title">What you run</h2>
      <p class="lead measure stack-lead">
        The same stack everywhere — on your own clusters, or preinstalled and
        supported on a vWorkspace appliance.
      </p>
      <div class="stack-list">
        {
          stack.map((s) => (
            <div class="stack-row">
              <strong>{s.layer}</strong>
              <p class="muted">{s.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>The contract</h2>
        <p class="muted">
          The control plane never holds a kubeconfig. It exchanges a narrow,
          versioned HTTP and CRD contract with the operator. The operator owns all
          cluster-side execution and reports status back.
        </p>
        <p class="muted" style="margin-top: 14px;">
          We use Odoo Community for a mature admin UI — deliberately, without Enterprise
          licensing. What you see is vWorkspace: custom login, workspace home, Kubernetes
          operator, backups, and private support AI.
        </p>
      </div>
      <div>
        <h2>The CRDs</h2>
        <div class="stack">
          {
            crds.map((c) => (
              <div class="row">
                <code>{c.name}</code>
                <p class="muted">{c.body}</p>
              </div>
            ))
          }
        </div>
        <a href={links.apiRef} target="_blank" rel="noopener" class="inline-link">Full API reference →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Connectivity</span>
      <h2 class="title">Pull mode first</h2>
      <p class="lead measure">
        vWorkspace ships with pull mode — clusters reach out, never the reverse.
        GitOps mode shares the same CRD contract for teams that prefer declarative Git workflows.
      </p>
      <div class="grid-3">
        {
          modes.map((m) => (
            <article class:list={["tile", { "tile--featured": m.featured, "tile--muted": m.muted }]}>
              <span class="tile__tag">{m.tag}</span>
              <h3>{m.name}</h3>
              <p class="muted">{m.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Execution engines</span>
      <h2 class="title">Reconciled by proven controllers</h2>
      <p class="lead measure">
        Operations delegate to battle-tested projects rather than reinventing them.
        vWorkspace orchestrates; the ecosystem executes.
      </p>
      <div class="chips">
        {engines.map((e) => <span class="chip">{e}</span>)}
      </div>
    </div>
  </section>

  <CTA
    title="See the architecture in depth"
    text="The operator docs cover reconciliation, pull-mode connectivity, security, and the full CRD reference."
    primaryLabel="Read the docs"
    primaryHref={links.operatorDocs}
    secondaryLabel="Get started"
    secondaryHref={links.quickstart}
  />
</BaseLayout>

<style>
  .title {
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 14px 0 8px;
  }
  .stack-list {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stack-row {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    align-items: start;
  }
  .stack-row strong {
    font-size: 15px;
    color: var(--brand-600);
  }
  .stack-row p {
    font-size: 15px;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
  }
  .split h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .row code {
    align-self: flex-start;
    font-size: 14px;
  }
  .inline-link {
    display: inline-block;
    margin-top: 22px;
    font-weight: 600;
  }
  .section--alt {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .grid-3 {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .tile--featured {
    border-color: rgba(0, 105, 255, 0.35);
    background: linear-gradient(180deg, rgba(0, 105, 255, 0.05), rgba(0, 105, 255, 0.01));
  }
  .tile--muted {
    opacity: 0.72;
  }
  .tile__tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-600);
    margin-bottom: 10px;
  }
  .tile h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }
  .tile p {
    font-size: 15px;
  }
  .chips {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-700);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 8px 16px;
  }

  @media (max-width: 820px) {
    .stack-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
