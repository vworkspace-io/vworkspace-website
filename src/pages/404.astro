---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <section class="nf">
    <div class="container">
      <span class="code">404</span>
      <h1>This page wandered off</h1>
      <p class="lead">The page you were looking for doesn't exist or has moved.</p>
      <div class="btn-row nf__row">
        <a class="btn btn--primary" href="/">Back home</a>
        <a class="btn btn--secondary" href="/solutions/">Explore solutions</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(80px, 14vw, 180px);
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--brand-600);
    font-size: 18px;
  }
  .nf h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin: 14px 0 16px;
  }
  .nf .lead {
    max-width: 46ch;
    margin-inline: auto;
  }
  .nf__row {
    justify-content: center;
    margin-top: 28px;
  }
</style>
