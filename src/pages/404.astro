---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested page could not be found. Explore vWorkspace, try knowledge search, or return home.">
  <section class="nf">
    <div class="container">
      <span class="code">404</span>
      <h1>This page doesn't exist</h1>
      <p class="lead">This page isn't here or has moved. Try the homepage, product overview, or knowledge search.</p>
      <div class="btn-row nf__row">
        <a class="btn btn--primary" href="/">Back home</a>
        <a class="btn btn--secondary" href="/product/">Explore the product</a>
      </div>
      <a class="knowledge-link" href="/knowledge/">Explore knowledge search</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-section);
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--brand-600);
    font-size: 18px;
  }
  .nf h1 {
    font-size: var(--heading-page);
    margin: 14px 0 16px;
  }
  .nf .lead {
    max-width: 46ch;
    margin-inline: auto;
  }
  .nf__row {
    justify-content: center;
    margin-top: 28px;
  }
  .knowledge-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 600;
  }
</style>
