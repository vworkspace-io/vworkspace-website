---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const included = [
  ["Dedicated environment", "A single-organization vWorkspace environment prepared for the agreed pilot scope."],
  ["Cloud AI connection", "A configured OpenAI-compatible API so the pilot can run without local GPU hardware."],
  ["Selected workflows", "A focused set of use cases chosen from the systems and information your team already works with."],
  ["Guided onboarding", "A walkthrough for administrators and the people who will evaluate the chosen workflows."],
  ["Success criteria", "Agreed questions, tasks, and operational outcomes used to review the pilot."],
  ["Next-step design", "A practical recommendation for cloud, customer infrastructure, or an on-prem appliance after evaluation."],
];

const steps = [
  ["Choose the problem", "Select a small number of useful workflows and identify the people who will test them."],
  ["Prepare the environment", "Configure the workspace, AI provider, sample data, access, and the integrations needed for the pilot."],
  ["Run real work", "Use representative documents, questions, and operations throughout the pilot."],
  ["Review the result", "Compare the pilot with the agreed success criteria and decide whether to continue, move, or stop."],
];

const faq = [
  {
    question: "Do we need to buy a GPU before starting?",
    answer: "No. A cloud pilot can use a configured OpenAI-compatible API. Local inference can be evaluated later if data residency, cost, or control makes it useful.",
  },
  {
    question: "Is the cloud pilot a multi-tenant SaaS product?",
    answer: "No. The current product model is one organization per installation. A cloud pilot is a dedicated evaluation environment, not a shared multi-tenant service.",
  },
  {
    question: "Can we move from the cloud pilot to our own infrastructure?",
    answer: "That is one possible next step. The review should identify whether your organization is better served by customer infrastructure, an on-prem appliance, or another dedicated setup.",
  },
  {
    question: "Which AI APIs can vWorkspace use?",
    answer: "vWorkspace supports a configurable OpenAI-compatible API path. The exact provider and privacy terms are agreed for the pilot.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Cloud-Hosted Private AI Pilot Without GPU Hardware"
  description="Start a dedicated vWorkspace cloud pilot without buying GPU hardware. Test private knowledge search and IT operations with your own workflows."
  schema={faqSchema}
>
  <PageHero
    eyebrow="Cloud pilot"
    title="Try vWorkspace with real work before buying hardware"
    text="Start in a dedicated cloud environment, connect an approved AI API, and evaluate the workflows that matter to your organization. A local GPU is not required."
  />

  <section class="section section--tight">
    <div class="container content-split">
      <div>
        <span class="eyebrow">A focused evaluation</span>
        <h2 class="section-title">Test the product value first</h2>
        <p class="muted">
          A useful pilot starts with a real question or operational problem.
          Search your own documents, review a representative Nextcloud or
          NetBird workflow, or test how AI experts support your team.
        </p>
      </div>
      <div class="pilot-example">
        <span>Example pilot</span>
        <strong>Knowledge and employee onboarding</strong>
        <p>
          Index a small approved document set, test common employee questions,
          review user access, and prepare a coordinated Nextcloud and NetBird
          onboarding plan.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What is included</span>
      <h2 class="section-title">Enough to judge fit on your own workflows</h2>
      <div class="included">
        {included.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Pilot process</span>
      <h2 class="section-title">From use case to evidence</h2>
      <ol class="steps">
        {steps.map(([title, body], index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{title}</h3>
              <p class="muted">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container content-split">
      <div>
        <span class="eyebrow eyebrow--dark">AI runtime</span>
        <h2>Use an API now. Consider local models later.</h2>
      </div>
      <div class="runtime-copy">
        <p>
          vWorkspace can connect to a configured OpenAI-compatible API. This
          removes the hardware requirement from the first evaluation.
        </p>
        <p>
          If the pilot moves forward, local inference on suitable GPU hardware
          can be considered alongside provider privacy, model quality, cost,
          and data-residency requirements.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Questions</span>
      <h2 class="section-title">What a cloud pilot is and is not</h2>
      <div class="faq">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Choose a workflow for your cloud pilot"
    text="Tell us what your team wants to search, understand, or operate. We will help define a focused pilot scope from there."
    primaryLabel="Start a cloud pilot"
    secondaryLabel="Explore product features"
    secondaryHref="/product/"
  />
</BaseLayout>

<style>
  .pilot-example {
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .pilot-example > span {
    display: block;
    margin-bottom: 8px;
    color: var(--brand-600);
    font-size: 12px;
    font-weight: 700;
  }
  .pilot-example strong {
    color: var(--ink-900);
    font-size: 18px;
  }
  .pilot-example p {
    margin-top: 10px;
    color: var(--ink-600);
    font-size: 14px;
  }
  .included {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 36px;
  }
  .included article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .included h3 {
    margin-bottom: 8px;
    font-size: 18px;
  }
  .included p {
    font-size: 14px;
  }
  .steps {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps li > span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .steps h3 {
    margin-bottom: 6px;
    font-size: 18px;
  }
  .steps p {
    font-size: 14px;
  }
  .section--dark {
    background: var(--dark-bg);
    color: var(--dark-muted);
  }
  .section--dark h2 {
    color: var(--white);
    font-size: var(--heading-section);
  }
  .eyebrow--dark {
    color: var(--blue-400);
  }
  .runtime-copy {
    display: grid;
    gap: 18px;
  }
  .runtime-copy p {
    font-size: 16px;
  }
  @media (max-width: 820px) {
    .included {
      grid-template-columns: 1fr;
    }
  }
</style>
