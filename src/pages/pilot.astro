---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { links } from "../config";

const subject = encodeURIComponent("vWorkspace pilot request");
const body = encodeURIComponent(`Hello vWorkspace team,

Organization:
Team size:
Country / deployment site:
Current file or workspace tools:
Primary use case: knowledge / Nextcloud / NetBird / identity / projects / storage / other
Preferred deployment: cloud pilot / appliance / own infrastructure / unsure
Preferred AI runtime: local model / cloud API / unsure
Storage and backup requirements:
What would make a pilot successful?

Thank you.`);
const pilotMailto = `${links.contact}?subject=${subject}&body=${body}`;

const questions = [
  "What does your organization use today for files, access, identity, and collaboration?",
  "How many people and deployment sites need to use the workspace?",
  "Which single workflow should the pilot test first?",
  "Do you prefer a cloud pilot, an appliance, your own infrastructure, or help deciding?",
  "Would you use a cloud AI API or evaluate a local model?",
  "What outcome would make the pilot successful for your team?",
];

const nextSteps = [
  ["We review the fit", "We compare your requirements with the current single-organization pilot scope."],
  ["We schedule a working session", "We focus on the chosen workflow, documents, access patterns, and operational questions."],
  ["We design the pilot", "If there is a fit, we agree deployment responsibilities, acceptance criteria, and the next commercial step."],
];
---

<BaseLayout
  title="Start a Private AI Workspace Pilot"
  description="Start a dedicated vWorkspace cloud or on-prem pilot with your own workflow, data, access patterns, and success criteria."
>
  <PageHero
    eyebrow="Cloud and on-prem pilots"
    title="Test one useful workflow with your own context"
    text="Choose one workflow to evaluate, such as knowledge search, file operations, private access, identity, projects, or backups. Start in the cloud if you do not have hardware yet."
  />

  <section class="section section--tight">
    <div class="container pilot-grid">
      <div>
        <span class="eyebrow">Start the conversation</span>
        <h2 class="section-title">A useful request takes a few minutes</h2>
        <p class="muted">
          The pilot is designed for one organization. It can run in a dedicated
          cloud environment, on supported hardware, or on customer
          infrastructure. AI can use a local model or a configured
          OpenAI-compatible API.
        </p>
        <a class="btn btn--primary email-button" href={pilotMailto}>Start your pilot request</a>
        <p class="email-note muted">
          This opens a prefilled email to <a href={links.contact}>{links.contactEmail}</a>.
          You can edit every field before sending.
        </p>
      </div>
      <aside class="questions">
        <h3>What to include</h3>
        <ol>
          {questions.map((question) => <li>{question}</li>)}
        </ol>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What happens next</span>
      <h2 class="section-title">A short, explicit qualification process</h2>
      <div class="next-steps">
        {nextSteps.map(([title, body], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Current scope</span>
        <h2 class="section-title">Clarity before commitment</h2>
      </div>
      <div class="callout">
        <strong>Dedicated single-organization pilot</strong>
        <p class="muted">
          A cloud pilot is a dedicated evaluation environment rather than a
          shared multi-tenant SaaS service. Deployment, support, timelines, data
          handling, and acceptance criteria are agreed before work begins.
        </p>
        <a class="text-link" href="/cloud-pilot/">Review the cloud pilot</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pilot-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: var(--space-split);
    align-items: start;
  }
  .email-button {
    margin-top: 28px;
  }
  .email-note {
    margin-top: 14px;
    font-size: 13px;
  }
  .email-note a {
    text-decoration: underline;
  }
  .questions {
    padding: 24px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .questions h3 {
    font-size: 20px;
  }
  .questions ol {
    margin: 22px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 16px;
  }
  .questions li {
    padding-left: 6px;
    color: var(--ink-700);
    font-size: 14px;
  }
  .questions li::marker {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .next-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 36px;
  }
  .next-steps article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .next-steps span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .next-steps h3 {
    margin: 18px 0 8px;
    font-size: 18px;
  }
  .next-steps p {
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .pilot-grid,
    .next-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
