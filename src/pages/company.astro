---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const principles = [
  {
    title: "Customers own their stack",
    body: "One organization per installation. Customers own their data, identities, credentials, storage destinations, and deployment environment.",
  },
  {
    title: "Open platform, commercial delivery",
    body: "The platform is open and auditable; the business is hardware bundles, installation, and support contracts — not a proprietary paywall around your data.",
  },
  {
    title: "Security as a design constraint",
    body: "Clusters reach out in pull mode; the control plane never holds a kubeconfig. Least privilege isn't an add-on — it's the architecture.",
  },
  {
    title: "Built with pilot customers",
    body: "We develop from concrete operational friction with reference customers. Product direction, design, and tracking remain visible on GitHub.",
  },
];

const repos = [
  { name: "vworkspace", body: "Project overview, GTM docs, design spikes, and tracking.", href: links.vworkspace },
  { name: "vworkspace-server", body: "Control plane on Odoo 19 CE — branded appliance UI, catalog, operations.", href: links.server },
  { name: "vworkspace-operator", body: "Pull-mode Kubernetes operator (Go) — CRDs, Flux, Velero.", href: links.operator },
];
---

<BaseLayout
  title="Company"
  description="vWorkspace builds a private workspace appliance with integrated applications, identity, storage, backup, secure access, and a human-approved AI specialist team."
>
  <PageHero
    eyebrow="Company"
    title="Making private infrastructure useful to real organizations"
    text="vWorkspace turns open infrastructure into a guided product: a private workspace, an AI specialist team, and a supported operating model on infrastructure the customer controls."
  />

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Principles</span>
      <div class="grid">
        {
          principles.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Built in the open</span>
      <h2 class="title">Three repositories, one product</h2>
      <div class="repos">
        {
          repos.map((r) => (
            <a class="repo" href={r.href} target="_blank" rel="noopener">
              <div>
                <code>{r.name}</code>
                <p class="muted">{r.body}</p>
              </div>
              <span class="repo__arrow">→</span>
            </a>
          ))
        }
      </div>
      <div class="links">
        <a href={links.governance} target="_blank" rel="noopener">Governance</a>
        <a href={links.contributing} target="_blank" rel="noopener">Contributing</a>
        <a href={links.security} target="_blank" rel="noopener">Security policy</a>
        <a href="/open-source/">Open-source overview</a>
      </div>
      <p class="muted license-note">
        Licensing is stated per repository. See the
        <a href="/open-source/">open-source overview</a> for the architecture,
        documentation, and commercial delivery model.
      </p>
    </div>
  </section>

  <CTA
    title="Work with vWorkspace"
    text="Evaluating a private workspace for your organization? Request a pilot. Want to build with us? Everything lives on GitHub."
    primaryLabel="Request a pilot"
    primaryHref={links.pilot}
    secondaryLabel="Explore on GitHub"
    secondaryHref={links.github}
  />
</BaseLayout>

<style>
  .grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .title {
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 14px 0 0;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .card h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  .card p {
    font-size: 15px;
  }
  .repos {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .repo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 26px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .repo:hover {
    text-decoration: none;
    border-color: var(--line-strong);
    transform: translateX(2px);
  }
  .repo code {
    font-size: 15px;
  }
  .repo p {
    margin-top: 6px;
    font-size: 14px;
  }
  .repo__arrow {
    color: var(--brand-600);
    font-size: 20px;
  }
  .links {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-weight: 500;
  }
  .license-note {
    margin-top: 20px;
    font-size: 14px;
    max-width: 62ch;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
