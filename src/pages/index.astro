---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const apps = [
  {
    name: "Nextcloud",
    sub: "Private files",
    body: "File sharing and collaboration on your own infrastructure — your Google Drive, without the Google.",
  },
  {
    name: "NetBird",
    sub: "Secure access",
    body: "Zero-trust remote access so staff reach apps from anywhere without exposing inbound ports.",
  },
  {
    name: "Odoo-for-Org",
    sub: "Org system of record",
    body: "Contacts, HR-lite, and invoicing — preinstalled with the control plane, not a separate deploy.",
  },
];

const pillars = [
  {
    title: "Data sovereignty",
    body: "Your data and your AI inference stay on infrastructure you control. No multi-tenant SaaS, no surprise cloud egress.",
  },
  {
    title: "Catalog-driven apps",
    body: "Deploy and upgrade applications from a curated catalog in a few clicks. GitOps under the hood — declarative, repeatable, reviewable.",
  },
  {
    title: "Private AI",
    body: "Run inference on your own GPU — IT support triage, log analysis, and AI-assisted administration, entirely on your hardware.",
  },
  {
    title: "Backups & audit built in",
    body: "Velero-backed backups as first-class operations, with a full audit trail — compliance-friendly by design.",
  },
  {
    title: "Secure by architecture",
    body: "Pull-mode operator: clusters reach out over HTTPS. No inbound ports, no kubeconfig on the control plane.",
  },
  {
    title: "Open platform, no lock-in",
    body: "Built on Kubernetes, Helm, Flux, and Velero. The platform is open and auditable — your workspace is never held hostage.",
  },
];

const platformParts = [
  {
    name: "Server",
    sub: "Control plane",
    body: "Admin UI for clusters, catalog, operations, and audit. Declares intent; never holds a kubeconfig.",
    href: links.serverDocs,
    cta: "Server docs",
  },
  {
    name: "Operator",
    sub: "Cluster agent",
    body: "Runs in your cluster, reconciles ApplicationInstance and Operation CRDs, executes via Flux and Velero.",
    href: links.operatorDocs,
    cta: "Operator docs",
  },
  {
    name: "Two CRDs",
    sub: "ApplicationInstance · Operation",
    body: "Day-2 work modeled as Kubernetes resources — not imperative scripts or dozens of per-app operators.",
    href: links.apiRef,
    cta: "API reference",
  },
];

const builtOn = ["Kubernetes", "Helm", "Flux CD", "Velero", "Ollama"];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="badge">Pilot program open</span>
      <h1>Your organization's workspace, on infrastructure you control</h1>
      <p class="lead hero__lead">
        vWorkspace gives your team everything a modern workspace needs — apps,
        secure networking, backups, and <strong>private AI</strong> — without
        handing your data to a public cloud. Deploy it on your own clusters, or
        get it preinstalled and supported on a ready-to-run appliance.
      </p>
      <div class="btn-row hero__cta">
        <a class="btn btn--primary" href={links.contact}>Request a pilot</a>
        <a class="btn btn--secondary" href="/platform/">See how it works</a>
      </div>
      <p class="hero__note muted">Open platform · Runs on any conformant Kubernetes · We install and support</p>
    </div>

    <div class="container">
      <div class="arch" aria-label="Architecture diagram">
        <div class="arch__node">
          <span class="arch__tag">Control plane</span>
          <strong>vWorkspace Server</strong>
          <span class="muted">Catalog · operations · audit</span>
        </div>
        <div class="arch__link">
          <span>Pull mode</span>
          <div class="arch__line"></div>
          <span class="muted">outbound HTTPS · CRD contract</span>
        </div>
        <div class="arch__node arch__node--brand">
          <span class="arch__tag">In your cluster</span>
          <strong>vworkspace-operator</strong>
          <span class="muted">Reconciles · executes · reports</span>
        </div>
      </div>
      <div class="arch__downstream">
        <span class="muted">built on</span>
        {builtOn.map((b) => <span class="chip">{b}</span>)}
      </div>
    </div>
  </section>

  <!-- Why / platform pillars -->
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">The platform</span>
      <h2 class="section__title">Everything an organization needs to own its stack</h2>
      <div class="features">
        {
          pillars.map((f) => (
            <div class="feature">
              <h3>{f.title}</h3>
              <p class="muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Apps -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Applications</span>
      <h2 class="section__title">A growing catalog, starting with the essentials</h2>
      <p class="lead measure">
        Apps deploy from the catalog with GitOps under the hood. Today's set covers
        files, networking, and org tools — the catalog is built to grow.
      </p>
      <div class="cards">
        {
          apps.map((a) => (
            <article class="card">
              <div class="card__head">
                <h3>{a.name}</h3>
                <span class="card__sub">{a.sub}</span>
              </div>
              <p>{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AI teaser -->
  <section class="section section--alt">
    <div class="container split">
      <div>
        <span class="eyebrow">Private AI</span>
        <h2 class="section__title">AI that works for your IT — on your GPU</h2>
        <p class="muted">
          vWorkspace treats private inference as a platform capability: triage
          Nextcloud sync failures from debug bundles, analyze cluster logs and
          health, and handle routine admin tasks like provisioning users — all on
          your hardware, all with admin approval. No data leaves your
          infrastructure, and no autonomous changes, ever.
        </p>
        <a href="/ai/" class="inline-link">Learn about private AI →</a>
      </div>
      <div class="flow" aria-label="Debug bundle AI flow">
        <div class="flow__step"><span>1</span> User uploads debug bundle</div>
        <div class="flow__arrow">↓</div>
        <div class="flow__step"><span>2</span> Local GPU analyzes (read-only)</div>
        <div class="flow__arrow">↓</div>
        <div class="flow__step"><span>3</span> Admin gets ranked suggestions</div>
      </div>
    </div>
  </section>

  <!-- Under the hood -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Under the hood</span>
      <h2 class="section__title">A small, legible system</h2>
      <p class="lead measure">
        One control plane, one pull-mode operator per cluster, and two CRDs
        reconciled by controllers you already trust.
      </p>
      <div class="cards">
        {
          platformParts.map((c) => (
            <article class="card">
              <div class="card__head">
                <h3>{c.name}</h3>
                <span class="card__sub">{c.sub}</span>
              </div>
              <p>{c.body}</p>
              <a href={c.href} target="_blank" rel="noopener" class="card__link">
                {c.cta} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Appliance option -->
  <section class="section section--alt">
    <div class="container split">
      <div>
        <span class="eyebrow">Prefer it ready to run?</span>
        <h2 class="section__title">The vWorkspace appliance</h2>
        <p class="muted">
          Don't want to operate Kubernetes yourself? The same platform ships
          preinstalled and supported on a hardware appliance at your site —
          control plane, apps, networking, backups, and a GPU for private AI,
          working out of the box. We install it; you own it.
        </p>
        <a href={links.contact} class="inline-link">Request a pilot →</a>
      </div>
      <div class="box" aria-label="Appliance contents">
        <span class="box__tag">In the box</span>
        <ul class="box__list">
          <li>vWorkspace Server + operator, preconfigured</li>
          <li>Nextcloud · NetBird · Odoo-for-Org</li>
          <li>GPU for on-prem AI inference</li>
          <li>Velero backups + audit trail</li>
          <li>Installed and supported by vWorkspace</li>
        </ul>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(48px, 6vw, 80px);
    background:
      radial-gradient(820px 420px at 78% -8%, rgba(0, 105, 255, 0.12), transparent 62%),
      radial-gradient(620px 360px at 6% 4%, rgba(42, 157, 143, 0.1), transparent 60%);
  }
  .hero__inner {
    text-align: center;
  }
  .badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-600);
    background: rgba(0, 105, 255, 0.08);
    border: 1px solid rgba(0, 105, 255, 0.2);
    padding: 6px 13px;
    border-radius: 999px;
    margin-bottom: 24px;
  }
  .hero h1 {
    font-size: clamp(34px, 5vw, 56px);
    max-width: 20ch;
    margin-inline: auto;
    font-weight: 720;
  }
  .hero__lead {
    margin: 24px auto 0;
    max-width: 64ch;
  }
  .hero__lead strong {
    color: var(--ink-800);
    font-weight: 600;
  }
  .hero__cta {
    justify-content: center;
    margin-top: 32px;
  }
  .hero__note {
    margin-top: 18px;
    font-size: 14px;
  }

  /* Architecture visual */
  .arch {
    margin-top: clamp(48px, 7vw, 80px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 28px;
  }
  .arch__node {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--surface-2);
  }
  .arch__node--brand {
    border-color: rgba(0, 105, 255, 0.4);
    background: linear-gradient(180deg, rgba(0, 105, 255, 0.06), rgba(0, 105, 255, 0.02));
  }
  .arch__node strong {
    font-size: 18px;
    color: var(--ink-900);
  }
  .arch__node .muted {
    font-size: 13px;
  }
  .arch__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .arch__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-700);
    min-width: 150px;
  }
  .arch__line {
    width: 100%;
    height: 2px;
    background: var(--gradient-brand);
    border-radius: 2px;
    position: relative;
  }
  .arch__line::before,
  .arch__line::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-500);
    transform: translateY(-50%);
  }
  .arch__line::before { left: -1px; }
  .arch__line::after { right: -1px; }

  .arch__downstream {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .chip {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-700);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 6px 14px;
  }

  .section--alt {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .section__title {
    font-size: clamp(26px, 3.6vw, 38px);
    margin-bottom: 16px;
    max-width: 24ch;
  }

  .cards {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }
  .card__head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .card__head h3 {
    font-size: 20px;
  }
  .card__sub {
    font-size: 13px;
    color: var(--ink-400);
    font-family: var(--font-mono);
  }
  .card p {
    color: var(--ink-500);
    font-size: 15px;
    flex: 1;
  }
  .card__link {
    font-weight: 600;
    font-size: 15px;
  }

  .features {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .feature h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 15px;
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .inline-link {
    display: inline-block;
    margin-top: 20px;
    font-weight: 600;
  }
  .flow {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flow__step {
    font-size: 15px;
    color: var(--ink-700);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .flow__step span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 105, 255, 0.1);
    color: var(--brand-600);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }
  .flow__arrow {
    text-align: center;
    color: var(--ink-400);
    font-size: 18px;
    line-height: 1;
  }

  .box {
    background: var(--surface);
    border: 1px solid rgba(0, 105, 255, 0.3);
    border-radius: var(--radius);
    padding: 28px;
  }
  .box__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-600);
    margin-bottom: 14px;
  }
  .box__list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-500);
    font-size: 15px;
  }
  .box__list li::marker {
    color: var(--brand-600);
  }

  @media (max-width: 920px) {
    .cards,
    .features {
      grid-template-columns: 1fr 1fr;
    }
    .split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .arch {
      grid-template-columns: 1fr;
    }
    .arch__link {
      flex-direction: row;
      gap: 10px;
    }
    .arch__line {
      width: 60px;
    }
    .cards,
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
