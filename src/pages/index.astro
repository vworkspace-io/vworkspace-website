---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { links, site } from "../config";

const useCases = [
  {
    label: "Knowledge",
    title: "Find answers across company knowledge",
    body: "Search trusted PDFs and Nextcloud folders, summarize documents, and trace answers back to their sources.",
    href: "/knowledge/",
    link: "Explore knowledge search",
  },
  {
    label: "Files",
    title: "Work with Nextcloud in context",
    body: "Review service health, users, shares, folders, and storage without treating Nextcloud as an isolated application.",
    href: "/product/#nextcloud",
    link: "See Nextcloud workflows",
  },
  {
    label: "Access",
    title: "Understand private network access",
    body: "Inspect NetBird peers, groups, policies, routes, DNS, and connectivity. Prepare sensitive changes for approval.",
    href: "/netbird-ai/",
    link: "Explore NetBird operations",
  },
  {
    label: "People",
    title: "Manage users across the workspace",
    body: "Review access and provisioning, then coordinate approved onboarding and offboarding across vWorkspace SSO, Nextcloud, and NetBird.",
    href: "/product/#identity",
    link: "See identity features",
  },
  {
    label: "Projects",
    title: "Turn project data into useful decisions",
    body: "Find overdue tasks, workload gaps, milestones, timesheet issues, and deadline risk. Approve task changes when needed.",
    href: "/ai-experts/#projects",
    link: "Meet the Projects expert",
  },
  {
    label: "Data",
    title: "Know whether your data is protected",
    body: "Review S3 inventory, backup health, recovery points, and storage signals. Authorized admins can approve an immediate backup.",
    href: "/product/#storage",
    link: "See storage and backup",
  },
];

const expertPrompts = [
  ["Knowledge", "Find our current onboarding policy and cite the source."],
  ["Nextcloud", "Summarize the project folder and show recent shares."],
  ["NetBird", "Why can this laptop not reach Nextcloud?"],
  ["Users", "Who has admin access, and who is not fully provisioned?"],
  ["Projects", "Which deadlines are at risk this month?"],
  ["Storage", "Check our latest backup and available restore points."],
];

const deployments = [
  {
    title: "Cloud pilot",
    body: "Start in a dedicated environment without buying hardware. Use an approved cloud AI API and validate the product with your own workflows.",
    href: "/cloud-pilot/",
    link: "Start without hardware",
  },
  {
    title: "On-prem appliance",
    body: "Run vWorkspace at your site with supported hardware, private infrastructure, and local AI where a suitable GPU is available.",
    href: "/appliance/",
    link: "Explore the appliance",
  },
  {
    title: "Your infrastructure",
    body: "Deploy the open core on a supported Kubernetes environment and connect your preferred storage and AI provider.",
    href: "/open-source/",
    link: "Review the open core",
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "vWorkspace",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Linux, Kubernetes",
  url: site.url,
  description: site.description,
  featureList: [
    "Private company knowledge search",
    "Nextcloud file and operations workflows",
    "NetBird access and connectivity management",
    "AI experts with human-approved actions",
    "vWorkspace SSO user lifecycle",
    "S3 storage and Velero backup operations",
    "Local AI and OpenAI-compatible API support",
  ],
};
---

<BaseLayout
  title="Private AI Workspace for Knowledge and Operations"
  description="Your knowledge, your AI experts, your workspace. Search trusted sources, run Nextcloud and NetBird workflows, and keep sensitive changes human-approved."
  schema={productSchema}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">Private AI workspace</span>
        <h1>Your knowledge. Your AI experts. Your workspace.</h1>
        <p class="lead">
          Bring company knowledge and daily operations into one private
          workspace. Search trusted documents, run Nextcloud and NetBird
          workflows, and keep storage and backups visible.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href="/product/">Explore what vWorkspace can do</a>
          <a class="btn btn--secondary" href={links.pilot}>Start a pilot</a>
        </div>
        <p class="hero__note">
          AI experts work from live workspace context to help your team
          investigate, plan, and act. Sensitive changes require approval.
        </p>
      </div>

      <div class="search-preview" aria-label="Example company knowledge search">
        <div class="search-preview__bar">
          <span class="search-preview__brand">Knowledge</span>
          <span class="search-preview__scope">Company sources</span>
        </div>
        <div class="search-preview__query">
          <span>@AI</span>
          <p>What is our process for onboarding a remote employee?</p>
        </div>
        <div class="search-preview__answer">
          <span class="answer-label">Answer</span>
          <p>
            Create the workspace account first, assign the approved access
            group, then provision Nextcloud and NetBird. The manager confirms
            access after the employee signs in.
          </p>
          <div class="sources">
            <span>Employee onboarding policy.pdf</span>
            <span>IT access checklist.pdf</span>
          </div>
        </div>
        <div class="search-preview__services">
          <span>Nextcloud</span>
          <span>NetBird</span>
          <span>vWorkspace SSO</span>
          <span>Projects</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">What your team can do</span>
      <h2 class="section-title">Useful answers and safer operations</h2>
      <p class="lead section-intro">
        vWorkspace connects the information your team relies on with the
        systems administrators operate every day.
      </p>
      <div class="use-cases">
        {useCases.map((item) => (
          <article class="use-case">
            <span class="use-case__label">{item.label}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
              <a class="text-link" href={item.href}>{item.link}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section knowledge">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Company knowledge</span>
        <h2 class="section-title">Give people a faster way to find what the company already knows</h2>
        <p class="muted">
          Build a searchable knowledge base from approved PDFs and Nextcloud
          folders. Teams can ask questions in natural language, summarize a
          folder, compare documents, and inspect the sources behind an answer.
        </p>
        <a class="text-link" href="/knowledge/">See how private knowledge search works</a>
      </div>
      <div class="knowledge__examples">
        <p>Find the latest remote work policy.</p>
        <p>Summarize the documents added to the customer folder this week.</p>
        <p>Compare the current backup procedure with the previous version.</p>
        <p>Which document defines access for external contractors?</p>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container experts">
      <div class="experts__intro">
        <span class="eyebrow eyebrow--dark">AI Experts</span>
        <h2>Ask once. The right expert picks up from there.</h2>
        <p>
          Mention <code>@AI</code> in Discuss. vWorkspace identifies the domain,
          uses the available tools, and returns the work to the same
          conversation.
        </p>
        <a class="btn btn--ghost-on-dark" href="/ai-experts/">Meet the AI experts</a>
      </div>
      <div class="expert-prompts">
        {expertPrompts.map(([expert, prompt]) => (
          <article>
            <span>{expert}</span>
            <p>{prompt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Human control</span>
        <h2 class="section-title">AI can investigate. People decide what changes.</h2>
        <p class="muted">
          Read requests can run through approved tools. When a request would
          change users, projects, Nextcloud, NetBird, or backups, vWorkspace
          shows the proposed work and waits for an authorized person.
        </p>
      </div>
      <ol class="approval-flow" aria-label="AI approval flow">
        <li><span>1</span><strong>Ask a question or request a change</strong></li>
        <li><span>2</span><strong>Review the findings and proposed work</strong></li>
        <li><span>3</span><strong>Approve or reject sensitive actions</strong></li>
        <li><span>4</span><strong>Review the result in the audit trail</strong></li>
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Start where you are</span>
      <h2 class="section-title">Try vWorkspace without changing your infrastructure first</h2>
      <p class="lead section-intro">
        Deployment is a choice, not the product story. Start with the option
        that makes evaluation easiest, then move when your requirements change.
      </p>
      <div class="deployments">
        {deployments.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p class="muted">{item.body}</p>
            <a class="text-link" href={item.href}>{item.link}</a>
          </article>
        ))}
      </div>
      <p class="runtime-note">
        AI can run through local models on a suitable GPU or through a
        configured OpenAI-compatible API. A local GPU is not required.
      </p>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(48px, calc(5vw + 18px), 88px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, calc(4vw + 12px), 64px);
    align-items: center;
  }
  .hero h1 {
    max-width: 16ch;
    font-size: clamp(34px, calc(2.8vw + 18px), 50px);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .hero .lead {
    max-width: 58ch;
    margin-top: 18px;
  }
  .hero__actions {
    margin-top: 22px;
  }
  .hero__note {
    max-width: 62ch;
    margin-top: 22px;
    color: var(--ink-600);
    font-size: 14px;
  }
  .search-preview {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .search-preview__bar {
    display: flex;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    font-size: 12px;
  }
  .search-preview__brand {
    color: var(--ink-900);
    font-weight: 700;
  }
  .search-preview__scope {
    color: var(--ink-600);
  }
  .search-preview__query,
  .search-preview__answer {
    margin: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 18px;
  }
  .search-preview__query {
    display: flex;
    gap: 12px;
  }
  .search-preview__query span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .search-preview__query p {
    color: var(--ink-800);
    font-size: 13px;
  }
  .answer-label {
    display: block;
    margin-bottom: 8px;
    color: var(--success);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .search-preview__answer > p {
    color: var(--ink-700);
    font-size: 13px;
  }
  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .sources span {
    padding: 5px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-600);
    font-size: 12px;
  }
  .search-preview__services {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 18px 18px;
  }
  .search-preview__services span {
    color: var(--ink-600);
    font-size: 12px;
  }
  .use-cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 42px;
    border-top: 1px solid var(--line);
  }
  .use-case {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 20px;
    padding: 22px 20px 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .use-case:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .use-case:nth-child(even) {
    padding-left: 20px;
  }
  .use-case__label {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .use-case h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .use-case p {
    font-size: 15px;
  }
  .knowledge__examples {
    display: grid;
    gap: 10px;
  }
  .knowledge__examples p {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-800);
    font-size: 14px;
  }
  .section--dark {
    background: var(--dark-bg);
    color: var(--dark-muted);
  }
  .experts {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, calc(4vw + 12px), 64px);
    align-items: start;
  }
  .experts h2 {
    color: var(--white);
    font-size: var(--heading-section);
  }
  .experts__intro > p {
    margin: 20px 0 28px;
    font-size: 16px;
  }
  .experts__intro code {
    background: var(--dark-surface);
    color: var(--white);
  }
  .eyebrow--dark {
    color: var(--blue-400);
  }
  .expert-prompts {
    border-top: 1px solid var(--dark-line);
  }
  .expert-prompts article {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--dark-line);
  }
  .expert-prompts span {
    color: var(--blue-400);
    font-size: 12px;
    font-weight: 600;
  }
  .expert-prompts p {
    color: var(--white);
    font-size: 14px;
  }
  .approval-flow {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .approval-flow li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .approval-flow span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .approval-flow strong {
    color: var(--ink-800);
    font-size: 15px;
  }
  .deployments {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 40px;
  }
  .deployments article {
    padding-top: 20px;
    border-top: 2px solid var(--ink-900);
  }
  .deployments h3 {
    margin-bottom: 10px;
    font-size: 19px;
  }
  .deployments p {
    font-size: 15px;
  }
  .runtime-note {
    margin-top: 36px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-700);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .hero__grid,
    .experts,
    .deployments {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 1024px) and (min-width: 901px) {
    .hero__grid {
      grid-template-columns: 1fr 0.9fr;
    }
    .deployments {
      gap: 20px;
    }
  }
  @media (max-width: 720px) {
    .use-cases {
      grid-template-columns: 1fr;
    }
    .use-case,
    .use-case:nth-child(even) {
      grid-template-columns: 1fr;
      padding: 24px 0;
      border-right: 0;
    }
  }
</style>
