---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { links } from "../config";

const productPillars = [
  {
    label: "Workspace",
    title: "Work in one private environment",
    body: "Bring Nextcloud files, NetBird access, organization tools, and one identity through vWorkspace SSO into a managed experience.",
  },
  {
    label: "AI Team",
    title: "Give operations a specialist team",
    body: "Start with @AI and get focused help for users, storage, networking, Nextcloud, DevOps, and project planning.",
  },
  {
    label: "Control",
    title: "Approve every sensitive change",
    body: "AI reads first. Changes arrive as a plan you can approve or reject, while operations and high-signal events remain auditable.",
  },
  {
    label: "Data",
    title: "Protect and move what matters",
    body: "Connect S3-compatible storage, browse and synchronize objects, configure Velero backup targets, and review backup state.",
  },
];

const prompts = [
  "Which users have not completed onboarding?",
  "Check Nextcloud health and explain the risk.",
  "Show our backup status and prepare a new backup.",
  "Turn this requirement into an implementation plan.",
];

const steps = [
  ["Connect your environment", "Use a supported appliance or register your Kubernetes cluster through the outbound pull-mode operator."],
  ["Deploy and manage services", "Launch catalog applications and manage identity, storage, backups, and operations from the control plane."],
  ["Ask AI and review the plan", "Specialists use live workspace context; authorized people approve sensitive actions before execution."],
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">Private workspace appliance</span>
        <h1>Your private workspace. Your AI team. Your infrastructure.</h1>
        <p class="lead">
          Run files, secure access, business tools, backups, and AI-assisted
          operations on infrastructure your organization controls. Deploy on
          your own cluster or get a ready-to-run appliance installed and
          supported at your site.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href={links.pilot}>Request a pilot</a>
          <a class="btn btn--secondary" href="/product/">Explore the product</a>
        </div>
        <ul class="trust" aria-label="Product principles">
          <li>Self-hosted</li>
          <li>Local AI by default</li>
          <li>Human-approved changes</li>
          <li>Open-source core</li>
        </ul>
      </div>
      <div class="workspace-preview" aria-label="vWorkspace product overview">
        <div class="preview__top">
          <span>Workspace Home</span>
          <span class="preview__status">Connected</span>
        </div>
        <div class="preview__body">
          <div class="preview__metric">
            <span>Services</span>
            <strong>Healthy</strong>
            <small>Nextcloud · NetBird · AI</small>
          </div>
          <div class="preview__apps">
            <span>Applications</span>
            <div><strong>Nextcloud</strong><small>Files and collaboration</small></div>
            <div><strong>AI Team</strong><small>Ask @AI in Discuss</small></div>
          </div>
          <div class="preview__prompt">
            <span>@AI</span>
            <p>Review workspace health and tell me what needs attention.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">One private workspace</span>
      <h2 class="section-title">Everything your organization needs to run its digital workspace</h2>
      <div class="content-grid">
        {productPillars.map((item) => (
          <article class="pillar">
            <span>{item.label}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-split ai-feature">
      <div>
        <span class="eyebrow">AI Team</span>
        <h2 class="section-title">Ask once. The right specialist takes it from there.</h2>
        <p class="muted">
          Ask <code>@AI</code> in Discuss to investigate an issue, review
          workspace health, plan work, or prepare an operational change.
          vWorkspace routes the request and returns the result to one
          conversation.
        </p>
        <p class="safety">
          Read-only work runs through defined tools. Changes that affect users,
          applications, networking, or storage require explicit approval.
        </p>
        <a class="text-link" href="/ai-team/">Meet the AI Team →</a>
      </div>
      <div class="prompt-stack" aria-label="Example AI Team requests">
        {prompts.map((prompt, index) => (
          <div class="prompt">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{prompt}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h2 class="section-title">Private infrastructure, calmly operated</h2>
      <div class="steps">
        {steps.map(([title, body], index) => (
          <article>
            <span>{index + 1}</span>
            <h3>{title}</h3>
            <p class="muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-split">
      <div>
        <span class="eyebrow">Deployment choice</span>
        <h2 class="section-title">Run it your way</h2>
        <p class="lead">
          The same product can be delivered as a supported appliance or run on
          infrastructure your team already controls.
        </p>
      </div>
      <div class="options">
        <article>
          <span>01</span>
          <div>
            <h3>Ready-to-run appliance</h3>
            <p class="muted">Installed and supported hardware for organizations that want the outcome without building the platform.</p>
            <a class="text-link" href="/appliance/">Explore the appliance →</a>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Your own infrastructure</h3>
            <p class="muted">Deploy the open core on a conformant Kubernetes cluster and connect your own storage and AI provider.</p>
            <a class="text-link" href="/open-source/">Explore the open core →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(72px, 9vw, 120px);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
  }
  .hero h1 {
    max-width: 14ch;
    font-size: clamp(40px, 5.5vw, 64px);
    font-weight: 700;
    letter-spacing: -0.045em;
  }
  .hero .lead {
    max-width: 61ch;
    margin-top: 24px;
  }
  .hero__actions {
    margin-top: 30px;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-600);
    font-size: 13px;
  }
  .trust li::before {
    content: "·";
    margin-right: 8px;
    color: var(--brand-600);
  }
  .workspace-preview {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform: rotate(1deg);
  }
  .preview__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-800);
    font-size: 13px;
    font-weight: 600;
  }
  .preview__status {
    color: var(--success);
  }
  .preview__body {
    padding: 20px;
    display: grid;
    gap: 14px;
    background: var(--surface-2);
  }
  .preview__metric,
  .preview__apps,
  .preview__prompt {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 18px;
  }
  .preview__metric {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
  }
  .preview__metric > span,
  .preview__apps > span {
    color: var(--ink-500);
    font-size: 12px;
  }
  .preview__metric strong {
    color: var(--success);
    font-size: 14px;
  }
  .preview__metric small {
    grid-column: 1 / -1;
    color: var(--ink-500);
  }
  .preview__apps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .preview__apps > span {
    grid-column: 1 / -1;
  }
  .preview__apps div {
    display: flex;
    flex-direction: column;
    padding: 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .preview__apps strong {
    color: var(--ink-900);
    font-size: 13px;
  }
  .preview__apps small {
    color: var(--ink-500);
    font-size: 10px;
  }
  .preview__prompt {
    display: flex;
    gap: 12px;
  }
  .preview__prompt span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .preview__prompt p {
    color: var(--ink-700);
    font-size: 12px;
  }
  .pillar {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 18px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .pillar > span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .pillar h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .pillar p {
    font-size: 15px;
  }
  .safety {
    margin-top: 24px;
    padding-left: 18px;
    border-left: 2px solid var(--brand-600);
    color: var(--ink-800);
    font-size: 15px;
  }
  .prompt-stack {
    display: grid;
    gap: 10px;
  }
  .prompt {
    display: flex;
    gap: 16px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .prompt span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .prompt p {
    color: var(--ink-800);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }
  .steps article > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--brand-600);
    font-size: 13px;
    font-weight: 700;
  }
  .steps h3 {
    margin: 20px 0 10px;
    font-size: 19px;
  }
  .steps p {
    font-size: 15px;
  }
  .options {
    display: grid;
    gap: 28px;
  }
  .options article {
    display: flex;
    gap: 20px;
  }
  .options article + article {
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .options article > span {
    color: var(--brand-600);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .options h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .options p {
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .hero__grid,
    .steps {
      grid-template-columns: 1fr;
    }
    .workspace-preview {
      transform: none;
    }
  }
  @media (max-width: 560px) {
    .pillar {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
